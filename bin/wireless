#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [[ -n "${NMAWW_HOME:-}" && -d "${NMAWW_HOME}/framework" ]]; then
    FRAMEWORK_HOME="${NMAWW_HOME}/framework"

elif [[ -d "/usr/local/share/nmaww/framework" ]]; then
    FRAMEWORK_HOME="/usr/local/share/nmaww/framework"

elif [[ -d "${SCRIPT_DIR}/../framework" ]]; then
    FRAMEWORK_HOME="$(cd "${SCRIPT_DIR}/../framework" && pwd)"

else
    echo "ERROR: Framework not found."
    exit 1
fi

for lib in \
    config.sh \
    colors.sh \
    logger.sh \
    common.sh \
    interfaces.sh \
    validation.sh \
    privilege.sh
do
    source "${FRAMEWORK_HOME}/lib/${lib}"
done

for module in "${FRAMEWORK_HOME}"/commands/*.sh
do
    source "${module}"
done

COMMAND="${1:-help}"

COMMAND="${1:-help}"

case "${COMMAND}" in
    help)
        cmd_help
        ;;

    version)
        cmd_version
        ;;

    status)
        cmd_status
        ;;

    monitor)
        cmd_monitor
        ;;

    station)
        cmd_station
        ;;

    restore)
        cmd_restore
        ;;

    scan)
        cmd_scan
        ;;

    capture)
        cmd_capture
        ;;

    deauth)
        cmd_deauth
        ;;

    *)
        echo "Unknown command: ${COMMAND}"
        echo
        cmd_help
        exit 1
        ;;
esac
